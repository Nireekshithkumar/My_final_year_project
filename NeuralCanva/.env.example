# Django
DEBUG=True
DJANGO_SECRET_KEY=change-me
RENDER_EXTERNAL_HOSTNAME=

# Redis / Valkey
# Local development: redis://127.0.0.1:6379/0
# Production (Render): rediss://default:your-password@your-host.render.com:6379
REDIS_URL=redis://127.0.0.1:6379/0

# Database
# Leave blank for local SQLite, or provide PostgreSQL URL (e.g. postgres://user:password@host/db)
DATABASE_URL=

# FastAPI ML Service
FASTAPI_URL=http://localhost:8001

# AI Copilot Provider Keys (Configured automatically in order of priority)
# 1. Groq (Recommended / Fast): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. Mistral AI: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# 4. OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
