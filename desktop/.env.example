# NeuralCanvas Desktop Configuration

# The URL Electron will load (defaults to deployed Vercel frontend or local Vite in dev)
# Development: http://localhost:5173
# Production: https://neuralcanvasteam.vercel.app
DESKTOP_FRONTEND_URL=https://neuralcanvasteam.vercel.app

# Deployed Django REST API Base URL
VITE_API_BASE_URL=https://neuralcanvas-backend.onrender.com/api

# Deployed Django Channels WebSocket Base URL
VITE_WS_BASE_URL=wss://neuralcanvas-backend.onrender.com/ws
